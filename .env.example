# Supabase Configuration
# Replace these with your project credentials from https://supabase.com -> Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Optional: HTTPS endpoint that accepts POST JSON for patient SMS/email (Twilio, SendGrid, n8n, etc.)
# Body shape: { channel: "sms"|"email", to, subject?, body, requisitionId, requisitionNumber, caseNo, patientName, sentAt }
# Without this URL, notifications are logged locally (demo mode) for development.
VITE_PATIENT_NOTIFY_WEBHOOK_URL=
