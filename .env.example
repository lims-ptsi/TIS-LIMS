# Supabase Configuration
# Replace these with your project credentials from https://supabase.com -> Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Patient pickup alerts — browser calls this webhook (same origin on Vercel is fine).
# Body: { channel: "sms"|"email", to, subject?, body, requisitionId, requisitionNumber, caseNo, patientName, sentAt }
# Production (Vercel): /api/patient-notify
VITE_PATIENT_NOTIFY_WEBHOOK_URL=/api/patient-notify

# Server-only — set in Vercel as Secret (never VITE_). Used by api/patient-notify.ts for Gmail SMTP.
# GMAIL_USER=your-lab@gmail.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# GMAIL_FROM_NAME=Lab-TIS Clinical Laboratory
